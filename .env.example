# --- Storage -------------------------------------------------------------
# "sheets" (production) or "local" (JSON file in .data/, no Google needed)
STORAGE_BACKEND=local

# Google Sheets backend
SPREADSHEET_ID=
# Paste the whole service-account JSON key on one line (or base64 of it)
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Auth ----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: skip Google and sign in as any Players email.
# Never set this in production.
DEV_LOGIN=true

# --- Migration -----------------------------------------------------------
# Spreadsheet ID of the old "Magic Records - 2026" sheet (read-only)
OLD_SPREADSHEET_ID=
