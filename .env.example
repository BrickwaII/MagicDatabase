# --- Database ------------------------------------------------------------
# Leave unset locally: the app uses PGlite, an in-process Postgres stored in
# .data/pglite (no account needed). In production set it to your Neon
# connection string (the Vercel Neon integration sets it for you).
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: direct (non-pooled) URL used only for migrations.
# DATABASE_URL_UNPOOLED=

# --- Auth ----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: skip Google and sign in as any player's email.
# Never set this in production.
DEV_LOGIN=true

# --- Migration from the old sheet (npm run migrate only) -----------------
# Spreadsheet ID of the old "Magic Records - 2026" sheet (read-only)
OLD_SPREADSHEET_ID=
# Service-account JSON key with Viewer access to that sheet, on one line (or base64 of it)
GOOGLE_SERVICE_ACCOUNT_KEY=
