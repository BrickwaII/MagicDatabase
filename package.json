    "next-auth": "^4.24.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.2",
